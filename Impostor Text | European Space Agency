    "def summarize_differences(model, df, summary=None):\n",
    "    chat = model.start_chat()\n",
    "    for idx, row in df.iterrows():\n",
    "        text1, text2, real_id = row['file_1'], row['file_2'], row['real_text_id']\n",
    "        if real_id == 1:\n",
    "            real, fake = text1, text2\n",
    "        else:\n",
    "            real, fake = text2, text1\n",
    "        if summary is None:\n",
    "            summary = chat.send_message(initial_prompt(real, fake)).text\n",
    "        else:\n",
    "            summary = chat.send_message(refinement_prompt(summary, real, fake)).text\n",
    "        time.sleep(10)  # Wait 10 seconds between calls\n",
    "    return summary"
   ]
