    "def plot_average_text_length(text_series, title='Distribution of Text Lengths'):\n",
    "    lengths = text_series.apply(len)\n",
    "    mean_length = lengths.mean()\n",
    "    median_length = lengths.median()\n",
    "    \n",
    "    plt.figure(figsize=(6, 3))\n",
    "    plt.hist(lengths, bins=30, color='skyblue', edgecolor='black')\n",
    "    plt.axvline(mean_length, color='red', linestyle='dashed', linewidth=2, label=f'Mean: {mean_length:.2f}')\n",
    "    plt.axvline(median_length, color='green', linestyle='dashed', linewidth=2, label=f'Median: {median_length:.2f}')\n",
    "    plt.title(title)\n",
    "    plt.xlabel('Text Length')\n",
    "    plt.ylabel('Frequency')\n",
    "    plt.legend()\n",
    "    plt.show()\n",
    "    \n",
    "    return mean_length, median_length\n",
    "\n",
    "plot_average_text_length(real_texts, title=\"Distribution of Real Text Lengths\")\n",
    "plot_average_text_length(fake_texts, title=\"Distribution of Fake Text Lengths\")"
   ]
