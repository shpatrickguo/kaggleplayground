    "    set1 = set(preprocess(text1))\n",
    "    set2 = set(preprocess(text2))\n",
    "    intersection = set1.intersection(set2)\n",
    "    union = set1.union(set2)\n",
    "    return len(intersection) / len(union) if union else 0.0\n",
