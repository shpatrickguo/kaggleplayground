    "def read_texts_from_dir(dir_path, debug=False):\n",
    "    \"\"\"\n",
    "    Reads 'file_1.txt' and 'file_2.txt' from each subfolder in the directory\n",
    "    and returns a DataFrame with columns: id, file_1, file_2\n",
    "\n",
    "    Args:\n",
    "        dir_path (str): Path to the parent directory containing subfolders.\n",
    "        debug (bool): If True, raises errors immediately for debugging.\n",
    "\n",
    "    Returns:\n",
    "        pd.DataFrame: DataFrame with columns ['id', 'file_1', 'file_2']\n",
    "    \"\"\"\n",
    "    data = []\n",
    "    error_count = 0\n",
    "    last_error = None\n",
    "\n",
    "    for folder_name in tqdm(sorted(os.listdir(dir_path))):\n",
    "        folder_path = os.path.join(dir_path, folder_name)\n",
    "        file1_path = os.path.join(folder_path, 'file_1.txt')\n",
    "        file2_path = os.path.join(folder_path, 'file_2.txt')\n",
    "\n",
    "        try:\n",
    "            with open(file1_path, 'r', encoding='utf-8') as f1:\n",
    "                text1 = f1.read().strip()\n",
    "            with open(file2_path, 'r', encoding='utf-8') as f2:\n",
    "                text2 = f2.read().strip()\n",
    "\n",
    "            # Extract numeric id from folder name\n",
    "            index = int(folder_name.split('_')[-1])\n",
    "            data.append((index, text1, text2))\n",
    "\n",
    "        except (FileNotFoundError, ValueError, OSError) as e:\n",
    "            error_count += 1\n",
    "            last_error = e\n",
    "            if debug:\n",
    "                raise e\n",
    "\n",
    "    print(f\"Read {len(data)} records with {error_count} errors\")\n",
    "    if error_count > 0:\n",
    "        print(\"Last Error:\", last_error)\n",
    "\n",
    "    return pd.DataFrame(data, columns=['id', 'file_1', 'file_2'])\n",
    "\n",
    "train = read_texts_from_dir(CFG.TRAIN_PATH)\n",
    "train_gt = pd.read_csv(CFG.TRAIN_GT_PATH)\n",
    "test = read_texts_from_dir(CFG.TEST_PATH)\n",
    "train = train.merge(train_gt, how='inner', on='id')\n",
    "train.set_index(\"id\", inplace=True)\n",
    "test.set_index(\"id\", inplace=True)"
   ]
