    "# Prompts\n",
    "def initial_prompt(real, fake):\n",
    "    prompt = (\n",
    "        \"You are given two texts.\\n\"\n",
    "        \"Text 1 is real.\\n\"\n",
    "        \"Text 2 is fake.\\n\\n\"\n",
    "        \"Analyze both text and explore the reasons why one text is authentic and other is not.\\n\"\n",
    "        \"Consider these aspects:\\n\"\n",
    "        \"- Consistency: Is the text logically consistent and free of contradictions?\\n\"\n",
    "        \"- Language and Style: Does the writing style match what is expected for real content of this type?\\n\"\n",
    "        \"- Specific Details: Are there concrete details, data, or context that support authenticity?\\n\"\n",
    "        \"- Common Signs of Fabrication: Does the fake text contain generic statements, errors, inconsistencies, or implausible claims?\\n\\n\"\n",
    "        \"Provide only a concise summary explaining why one text is real and the other is fake.\\n\"\n",
    "        f\"Text 1: {real}\\n\\n\"\n",
    "        f\"Text 2: {fake}\"\n",
    "    )\n",
    "    return prompt\n",
    "\n",
    "def refinement_prompt(previous_summary, real, fake):\n",
    "    prompt = (\n",
    "        \"You are given two text.\\n\"\n",
    "        \"Text 1 is real.\\n\"\n",
    "        \"Text 2 is fake.\\n\\n\"\n",
    "        \"Your task is to refine the previous summary explaining why Text 1 is real and Text 2 is fake, \"\n",
    "        \"incorporating new analysis from the following texts.\\n\\n\"\n",
    "        f\"Previous summary:\\n{previous_summary}\\n\\n\"\n",
    "        \"New texts to analyze:\\n\"\n",
    "        f\"Text 1: {real}\\n\\n\"\n",
    "        f\"Text 2: {fake}\"\n",
    "        \"Consider the same aspects as before: Consistency, Language and Style, Specific Details, Common Signs of Fabrication.\\n\"\n",
    "        \"Please provide only a refined, concise summary as your output.\"\n",
    "    )\n",
    "    return prompt"
   ]
