    "def predict_prompt(summary, text1, text2):\n",
    "    prompt = (\n",
    "        \"You are given two texts. One is real, and the other is fake.\\n\"\n",
    "        \"Based on the following summary of distinguishing features between real and fake articles, \"\n",
    "        \"identify which text is real and which is fake.\\n\\n\"\n",
    "        f\"Summary of distinguishing features:\\n{summary}\\n\\n\"\n",
    "        f\"Text 1:\\n{text1}\\n\\n\"\n",
    "        f\"Text 2:\\n{text2}\\n\\n\"\n",
    "        \"Output only the number of the real text: 1 or 2. Do not include any explanation.\"\n",
    "    )\n",
    "    return prompt\n",
    "\n",
    "def predict(model, df, summary):\n",
    "    preds = []\n",
    "    for idx, row in df.iterrows():\n",
    "        text1, text2 = row['file_1'], row['file_2']\n",
    "        prompt = predict_prompt(summary, text1, text2)\n",
    "        pred = model.generate_content(prompt).text\n",
    "        preds.append(pred)\n",
    "    return preds"
   ]
