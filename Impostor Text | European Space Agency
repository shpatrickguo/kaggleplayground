    "def jaccard_similarity(text1, text2):\n",
    "    set1 = set(preprocess(text1))\n",
    "    set2 = set(preprocess(text2))\n",
    "    intersection = set1.intersection(set2)\n",
    "    union = set1.union(set2)\n",
    "    return len(intersection) / len(union) if union else 0.0\n",
    "\n",
    "train_df['jaccard_similarity'] = apply_similarity(train_df, jaccard_similarity)\n",
    "test_df['jaccard_similarity'] = apply_similarity(test_df, jaccard_similarity)\n",
    "\n",
    "plot_similarity(train_df, 'jaccard_similarity', 'Jaccard Similarity', 'Distribution of Similarity in Train Data')\n",
    "plot_similarity(test_df, 'jaccard_similarity', 'Jaccard Similarity', 'Distribution of Similarity in Test Data')"
